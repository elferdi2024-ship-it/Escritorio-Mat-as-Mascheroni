# 🐘 Supabase (Base de datos y Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (Anon public key)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (Service role key secreta)

# 🔒 Autenticación del Administrador (Cookie HMAC)
ADMIN_USER=admin
ADMIN_PASS=cambia_esto_por_una_clave_segura
ADMIN_SECRET=un_string_largo_random_y_seguro_de_64_caracteres
CRON_SECRET=otro_string_random_secreto_para_cron_jobs

# 🎨 Multi-Tenant Branding (demo, remates-del-sur, agro-subastas)
NEXT_PUBLIC_BRAND=demo

# 📧 Notificaciones por Email (Resend)
RESEND_API_KEY=re_...

# 💬 Notificaciones por WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+14155238886

# 💳 Pasarela de Pagos (Mercado Pago - Fase 2)
MP_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
